{
  "schema": "desarrollamo.amo.v1",
  "amo_version": "1.0.0",
  "id": "cerebramo",
  "name": "CerebrAMO",
  "kind": "intelligence",
  "origin": "legacy",
  "membership": "candidate",
  "trust": "inspected",
  "unit": {
    "purpose": "Enrutar tareas entre proveedores de IA y mantener un inventario verificable de combustible, cuotas y salud del ecosistema.",
    "responsibility": "Gestionar failover de IA y normalizar recursos con valor, límite, vencimiento/reset, fuente, última lectura y estado, sin inventar métricas ni copiar secretos.",
    "owner": "human_responsible",
    "capabilities": [
      "llm-routing",
      "provider-failover",
      "provider-auth-delegation",
      "resource-inventory",
      "host-telemetry",
      "quota-health-dashboard"
    ]
  },
  "model": {
    "inherits": [],
    "context": ["README.md", "cerebramo.py", "tests", ".github/workflows/test.yml"],
    "rules": [
      "CerebrAMO no debe almacenar claves de proveedores en Git.",
      "La autenticación de proveedores se delega a OpenCode.",
      "Un recurso sin fuente válida debe permanecer unknown; nunca se fabrican saldos, cuotas o estados.",
      "La telemetría local del host puede leerse directamente cuando no requiere privilegios adicionales.",
      "Los cambios deben conservar tests unitarios verdes antes de integrarse."
    ]
  },
  "map": {
    "parent": "raizamo",
    "children": [],
    "relations": [
      {"type": "orchestrates", "target": "external-llm-providers", "strength": "strong"},
      {"type": "observes", "target": "damo-host", "strength": "strong"},
      {"type": "observes", "target": "external-resource-providers", "strength": "medium"}
    ],
    "covers": ["cerebramo.py", "bin/**", "tests/**"]
  },
  "policy": {
    "contains_provider_credentials": false,
    "delegates_authentication": true,
    "unknown_is_not_pass": true,
    "resource_sources_must_be_explicit": true
  },
  "provenance": {
    "source_uri": "https://github.com/amoedo7/CerebrAMO",
    "source_type": "git-repository",
    "source_ref": "main"
  },
  "health": {
    "checks": [
      {
        "id": "cerebramo-autocheck",
        "type": "command",
        "command": "bash scripts/autocheck.sh",
        "cwd": ".",
        "timeout_seconds": 120,
        "description": "Compila sintaxis Python, ejecuta tests unitarios y verifica que el repositorio no contenga patrones obvios de credenciales de proveedores."
      }
    ]
  },
  "evidence": {
    "status": "inspected",
    "refs": [".github/workflows/test.yml", "scripts/autocheck.sh", "tests"]
  }
}
